  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/",
    "src-tauri/gen/",
    "src-tauri/target/",
    "src-tauri/resources/themes/page-adapter.js",
    "outputs/",
    "website/"
  ]
}
